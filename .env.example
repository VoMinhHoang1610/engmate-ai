APP_NAME=EngMate-AI
# Optional private avatar directory; defaults to .artifacts/avatars for local runs.
AVATAR_STORAGE_DIR=
BACKEND_PORT=8010
FRONTEND_PORT=5174
BACKEND_URL=http://127.0.0.1:8010
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Runtime chỉ dùng AI thật; mock bị từ chối và chỉ tồn tại trong thư mục tests.
LLM_PROVIDER=gemini
# Blaze nhận/phát giọng nói; Gemini chỉ sinh nội dung văn bản.
VOICE_PROVIDER=blaze
# VOICE_PROVIDER=native chỉ để dùng lại Gemini Live/OpenAI Realtime của cấu hình cũ.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Chỉ dùng khi VOICE_PROVIDER=native; không phát giọng Gemini trong chế độ blaze.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
GEMINI_MAX_OUTPUT_TOKENS=2048
# OpenAI tùy chọn cho cấu hình cũ; không được gọi khi LLM_PROVIDER=gemini.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin
OPENAI_MAX_OUTPUT_TOKENS=800
VOICE_MAX_SESSION_SECONDS=600
VOICE_VAD_SILENCE_MS=900
VOICE_VAD_THRESHOLD=0.5
# Khóa Blaze dùng cho thoại trực tiếp, ghi âm STT và toàn bộ giọng đọc TTS.
BLAZE_API_KEY=
BLAZE_TTS_MODEL=v2.0_pro
BLAZE_STT_MODEL=stt-async-1.5
# Opt-in after verifying access/accuracy; realtime failures retry batch once (extra cost).
BLAZE_STT_MODE=batch
BLAZE_STT_REALTIME_MODEL=stt-stream-1.5
# Bounded provider jobs per process/account; reject overload before paid work.
SPEECH_MAX_JOBS=16
SPEECH_MAX_JOBS_PER_USER=4
CHAT_MAX_JOBS=16
CHAT_MAX_JOBS_PER_USER=2
VOICE_TIMING_LOGS=false
# Chỉ dùng để thử speech loopback khi không cấu hình database.
BLAZE_LOCAL_DEMO=false
# Chọn một database. Không lưu secret vào biến VITE_*.
DATABASE_MYSQL_URL=
# mysql+pymysql://username:password@127.0.0.1:3306/EngMateAI?charset=utf8mb4
# Docker trên Windows: cấu hình riêng host.docker.internal thay 127.0.0.1.
DOCKER_DATABASE_MYSQL_URL=
# Adapter tương thích dữ liệu SQL Server v1; không dùng đồng thời với MySQL.
DATABASE_ODBC_CONNECTION=
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AUTH_REQUESTS_PER_MINUTE=30
# Chỉ dùng schema test đã bootstrap, tên kết thúc _test, chưa có tài khoản.
MYSQL_TEST_URL=
# OAuth: callbacks must use this exact public frontend origin (no trailing slash).
OAUTH_PUBLIC_ORIGIN=http://127.0.0.1:5174
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v24.0
