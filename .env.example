# Cổng host của stack phát triển; Docker backend dùng cổng nội bộ 8000.
BACKEND_PORT=8010
FRONTEND_PORT=5174
APP_NAME=EngMate-AI
LLM_PROVIDER=mock
# Blaze speech credentials are server-only; leave empty to disable TTS/STT.
BLAZE_API_KEY=
BLAZE_TTS_MODEL=v2.0_pro
BLAZE_STT_MODEL=stt-async-1.5
# Opt-in for loopback demo without SQL/JWT; disable outside local development.
BLAZE_LOCAL_DEMO=false
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Keep both empty for the standalone mock demo. Configure to enable persisted APIs.
# Windows: DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=EngMateAI;Trusted_Connection=yes;TrustServerCertificate=yes
# Docker: use ODBC Driver 18, an accessible SQL Server host and SQL authentication.
DATABASE_ODBC_CONNECTION=
# Generate privately: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required minimum 32 characters when DATABASE_ODBC_CONNECTION is set.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AUTH_REQUESTS_PER_MINUTE=30
# Relative to repo root; ignored .artifacts stores uploaded private assets.
MEDIA_DIRECTORY=.artifacts/media
# Optional password-reset delivery. API returns 503 until host AND sender are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
FRONTEND_URL=http://127.0.0.1:5174

# Tests only: must target tempdb with NO existing em schema. All test DDL/data rolls back.
# Set in the shell when running integration/coverage; never point at application data.
SQLSERVER_TEST_ODBC_CONNECTION=

# MySQL schema created from gemini-code-1791478978574.sql; set only one DB connection.
DATABASE_MYSQL_URL=
# Example: mysql+pymysql://username:password@localhost:3307/EngMateAI?charset=utf8mb4
# Compose frontend mode; local Vite reads frontend/.env.local instead.
VITE_DATA_SOURCE=demo
# Integration tests only: separate initialized schema ending in _test, with no accounts.
MYSQL_TEST_URL=
